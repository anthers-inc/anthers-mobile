# The web app, resolved in by scripts/resolve-web.ts. A build artifact, never committed.
/web-dist/
/.web-dist.tar.gz

node_modules/

# Task worktrees live inside the checkout, as they do in every Anthers repository.
/.worktrees/

# Rust build output.
/src-tauri/target/

# The Android and iOS projects carry their own build output and local SDK paths.
/src-tauri/gen/android/.gradle/
/src-tauri/gen/android/build/
/src-tauri/gen/android/app/build/
/src-tauri/gen/android/local.properties
/src-tauri/gen/apple/build/

# The emulator's stderr, written by `make emulator`. A crash leaves its reason here.
/.emulator.log
