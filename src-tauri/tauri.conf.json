{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Anthers",
	"version": "2026.11.14",
	"identifier": "org.anthers.mobile",
	"build": {
		"beforeDevCommand": "bun run scripts/resolve-web.ts",
		"devUrl": "http://10.0.2.2:3000",
		"beforeBuildCommand": "bun run scripts/resolve-web.ts",
		"frontendDist": "../web-dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Anthers",
				"width": 400,
				"height": 860,
				"resizable": false
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self' https://js.stripe.com https://*.js.stripe.com",
				"style-src": "'self'",
				"style-src-attr": "'unsafe-inline'",
				"img-src": "'self' data: blob: https:",
				"media-src": "'self' blob: https://anthers.org https://42e9a13ee9f7af4092581dc675c9f4da.r2.cloudflarestorage.com",
				"font-src": "'self'",
				"connect-src": "'self' https://anthers.org https://42e9a13ee9f7af4092581dc675c9f4da.r2.cloudflarestorage.com ipc: http://ipc.localhost https://api.stripe.com",
				"frame-src": "https: blob:",
				"worker-src": "'self' blob:",
				"manifest-src": "'self'",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'self'"
			},
			"devCsp": {
				"default-src": "'self'",
				"script-src": "'self' 'unsafe-inline'",
				"style-src": "'self' 'unsafe-inline'",
				"img-src": "'self' data: blob: http: https://anthers.org https://cdn.anthers.org",
				"media-src": "'self' blob: http:",
				"font-src": "'self' data:",
				"connect-src": "'self' http: ws: ipc: http://ipc.localhost https://api.stripe.com",
				"frame-src": "https: http: blob:",
				"worker-src": "'self' blob:",
				"manifest-src": "'self'",
				"object-src": "'none'",
				"base-uri": "'none'",
				"form-action": "'self'"
			}
		}
	},
	"bundle": {
		"active": true,
		"publisher": "Anthers, Inc.",
		"copyright": "Copyright (c) 2026 Anthers, Inc.",
		"category": "Entertainment",
		"shortDescription": "Anthers \u2014 the creative garden, in your hand",
		"longDescription": "The Anthers app for Android and iOS \u2014 the whole platform in a native app, for readers and creators alike: browse, read, watch and play, publish and manage a catalog and posts. It is the Anthers experience you know from the web, not a separate tool.",
		"licenseFile": "../LICENSE",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"deep-link": {
			"mobile": [
				{
					"scheme": [
						"https"
					],
					"host": "anthers.org",
					"appLink": true
				}
			]
		}
	}
}
